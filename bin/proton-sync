#!/bin/bash
# Launcher: resolves its real path (including symlinks) then starts src/main.ts with bun.
set -e
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
    DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
    SRC="$(readlink "$SRC")"
    case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"

if command -v bun >/dev/null 2>&1; then
    BUN="$(command -v bun)"
elif [ -x "$HOME/.local/bin/bun" ]; then
    BUN="$HOME/.local/bin/bun"
elif [ -x "$HOME/.bun/bin/bun" ]; then
    BUN="$HOME/.bun/bin/bun"
else
    echo "proton-sync: bun not found (PATH, ~/.local/bin/bun or ~/.bun/bin/bun)" >&2
    exit 1
fi

exec "$BUN" run "$ROOT/src/main.ts" "$@"
