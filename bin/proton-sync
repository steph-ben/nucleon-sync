#!/bin/bash
# Lanceur : résout son vrai chemin (liens symboliques compris) puis démarre src/main.ts avec bun.
set -e
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
    DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
    SRC="$(readlink "$SRC")"
    case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"

if command -v bun >/dev/null 2>&1; then
    BUN="$(command -v bun)"
elif [ -x "$HOME/.local/bin/bun" ]; then
    BUN="$HOME/.local/bin/bun"
else
    echo "proton-sync : bun introuvable (PATH ou ~/.local/bin/bun)" >&2
    exit 1
fi

exec "$BUN" run "$ROOT/src/main.ts" "$@"
