#!/bin/bash
# Launcher: resolves its real path (including symlinks), then starts with bun the bundled nucleon-sync.js, or src/main.ts in a checkout.
set -e
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
    DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
    SRC="$(readlink "$SRC")"
    case "$SRC" in /*) ;; *) SRC="$DIR/$SRC" ;; esac
done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"

# Installed: ROOT is <app>/versions/<v>, and <app>/bun/bun is the bun shipped with the app.
APP="$ROOT/../.."
if [ -x "$APP/bun/bun" ] && [ -f "$ROOT/nucleon-sync.js" ]; then
    BUN="$APP/bun/bun"
elif command -v bun >/dev/null 2>&1; then
    BUN="$(command -v bun)"
elif [ -x "$HOME/.local/bin/bun" ]; then
    BUN="$HOME/.local/bin/bun"
elif [ -x "$HOME/.bun/bin/bun" ]; then
    BUN="$HOME/.bun/bin/bun"
else
    echo "nucleon-sync: bun not found (PATH, ~/.local/bin/bun or ~/.bun/bin/bun)" >&2
    exit 1
fi

if [ -f "$ROOT/nucleon-sync.js" ]; then
    exec "$BUN" run "$ROOT/nucleon-sync.js" "$@"
fi
exec "$BUN" run "$ROOT/src/main.ts" "$@"
