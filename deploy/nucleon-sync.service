[Unit]
Description=nucleon-sync: two-way sync with Proton Drive
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/nucleon-sync run
Restart=always
RestartSec=30
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=NUCLEON_SYNC_HOME=%h/.local/share/nucleon-sync

[Install]
WantedBy=default.target
