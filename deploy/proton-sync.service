[Unit]
Description=proton-sync: two-way sync with Proton Drive
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/dev/proton-sync/bin/proton-sync run
Restart=always
RestartSec=30
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
